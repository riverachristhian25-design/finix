# Copia este archivo a ".env" y completa los valores reales.
# NUNCA subas el archivo ".env" real a git ni lo compartas.

PORT=3000
NODE_ENV=development

# Usuario para entrar a /admin/generador-productos.html
ADMIN_USER=finixadmin

# Hash de la contraseña (NO la contraseña en texto plano).
# Genera uno con:  npm run hash-password -- "tu-contraseña"
ADMIN_PASS_HASH=

# Cadena larga y aleatoria para firmar la sesión. Cambia esto siempre.
SESSION_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio
